# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_inventory_db

# ---------- JWT ----------
# Use long, random, DIFFERENT values for the two secrets
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Security ----------
BCRYPT_SALT_ROUNDS=10

# ---------- CORS / Cookies ----------
# Allowed browser origin for REST and Socket.IO (the demo client is served from the same origin)
CLIENT_ORIGIN=http://localhost:5000
# Set to true only when serving over HTTPS
COOKIE_SECURE=false